# Copy this file to ".env" (same folder, or in your ComfyUI root) and fill in the keys
# you use. Keys are read in this order:  node field  ->  OS env var  ->  this .env file.
# So pasting a key into the node is optional.

# Replicate — https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Future providers (examples, not used yet):
# OLLAMA_HOST=http://localhost:11434
# FAL_KEY=xxxxxxxxxxxxxxxx
