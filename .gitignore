__pycache__/
*.pyc
*.pyo
.DS_Store

# never commit real API keys
.env

# PRIVATE — the real-estate design nodes and their catalog. Local to this machine and
# deliberately never published: the catalog carries a design platform's system
# instructions. The pack loader tolerates the folder being absent, so a clone of this
# repo works normally without it.
realestate/
web/realestate.js

# PRIVATE — the hairstyle nodes and their catalog. Same arrangement as realestate/:
# the catalog IS the product (ten workflows of authored system instructions), so it is
# local to this machine and deliberately never published. The pack loader tolerates the
# folder being absent.
hairstyle/
web/hairstyle.js

# PRIVATE — the thumbnail-localisation nodes and their catalog. Same arrangement again:
# 57 markets of authored system instructions and 59 languages of typographic data are the
# product, so they stay local to this machine.
thumbnail/
web/thumbnail.js

# PRIVATE — the product / interior-design variation pipeline and its prompts. Unlike the
# four packages above this one was published once, in 6d84cf4, before the rule was
# settled: recipe.py carries the compiler meta-prompt and both stock locks as widget
# defaults, and those are the product. Removed from the repo here; the history rewrite is
# what actually takes them off GitHub.
variation/
web/variation.js

# local-only workflows — kept on disk, deliberately not published.
# Only these ship: Character Dataset (GPT-Image-2) - Codex,
# HyperConsistent StoryMaker - OpenAI, HyperConsistent StoryMaker - Flux 2.
example workflows/nemasis-bean.json
example workflows/nemasis-cartoon.json
example workflows/nemasis-hyperconsistent.json
example workflows/nemasis-maldives.json
example workflows/nemasis-pitch.json
example workflows/nemasis-space.json

# Third-party code and a private dependency tree, both vendored on purpose:
#   vendor/qwen_tts  - the upstream Qwen3-TTS package, so a shared workflow does not need
#                      `pip install qwen-tts` (which needs a source build that fails here)
#   vendor/tts_env   - transformers 4.57.3, used ONLY by the TTS subprocess so the main
#                      environment can stay on 5.x for the other eleven packs
# Not committed: 114 MB, and redistributing someone else's package is a decision to make
# deliberately rather than by `git add .`.
vendor/

# PRIVATE — the ecom pose-library nodes and their catalog. Same arrangement as the three
# above: five families of authored system instructions, whose lock (same person, same
# garment, same white ground) is the product, so they stay local to this machine.
ecom/
web/ecom.js
